# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_voucher_db

# JWT (use a long random string in real deployments)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Signature uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=2
